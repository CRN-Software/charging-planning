{
  "name": "@charging/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Nuxt SSR app: weekly calendar, battery forecast and charging plan",
  "scripts": {
    "build": "nuxt build",
    "clean": "rm -rf .output .nuxt dist coverage",
    "dev": "nuxt dev --port 5123",
    "lint": "eslint .",
    "postinstall": "nuxt prepare",
    "preview": "nuxt preview",
    "start": "PORT=5123 node .output/server/index.mjs",
    "test": "vitest run --coverage",
    "typecheck": "nuxt typecheck"
  },
  "dependencies": {
    "@charging/planner": "workspace:*",
    "@fontsource-variable/bricolage-grotesque": "^5.2.5",
    "@fontsource-variable/figtree": "^5.2.5",
    "@fontsource-variable/jetbrains-mono": "^5.2.5",
    "@pinia/nuxt": "^1.0.2",
    "nuxt": "^4.5.2",
    "pinia": "^4.0.3",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@charging/tooling": "workspace:*",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.1.0",
    "@vitest/coverage-v8": "catalog:",
    "@vue/test-utils": "^2.4.6",
    "eslint": "catalog:",
    "happy-dom": "^20.0.0",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "vue-tsc": "^3.3.11"
  }
}
